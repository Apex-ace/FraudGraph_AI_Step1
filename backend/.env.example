# Replace with your own Supabase project values.
# Supabase Dashboard > Project Settings > API / API Keys
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Supabase Dashboard > Connect > Session Pooler (recommended for IPv4 dev)
# Use the EXACT host/username from Supabase. URL-encode special characters in password.
# Copy postgresql:// and change its prefix to postgresql+psycopg://, or leave
# postgresql:// and the application will convert it automatically.
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:URL_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres

FRONTEND_ORIGIN=http://localhost:5173
APP_ENV=development
