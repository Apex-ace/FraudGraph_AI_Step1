# Fast offline-friendly setup. Existing old DATABASE_URL may remain;
# it is ignored when DB_PROVIDER=sqlite.
DB_PROVIDER=sqlite
AUTH_MODE=local
LOCAL_SQLITE_PATH=data/fraudgraph.db
LOCAL_AUTH_SECRET_FILE=data/local_auth_secret.key
FRONTEND_ORIGIN=http://localhost:5173
# Optional for trusted LAN sharing when not using START_TEAM_LAN.ps1:
# LAN_FRONTEND_ORIGIN=http://192.168.1.34:5173
APP_ENV=development

# Optional remote compatibility settings (disabled by default):
# DB_PROVIDER=postgres
# AUTH_MODE=supabase
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# DATABASE_URL=postgresql+psycopg://...
