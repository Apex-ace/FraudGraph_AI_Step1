# Default: local login and SQLite database; no Supabase keys required.
VITE_AUTH_MODE=local
VITE_API_URL=http://localhost:8000

# ONLY if backend AUTH_MODE=supabase:
# VITE_AUTH_MODE=supabase
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# LAN devices are automatically routed to the host laptop API by src/lib/api.js.
# START_TEAM_LAN.ps1 overrides any old VITE_API_URL=localhost value at launch.
